  "$id": "https://j26.invalid/contracts/1.0.0/C4ComparisonEvaluatedResponse.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "coverage": {
      "$ref": "#/$defs/C4CoverageCard"
    },
    "development_only": {
      "const": true,
      "default": true,
      "title": "Development Only",
      "type": "boolean"
    },
    "language_groups": {
      "default": [],
      "items": {
        "$ref": "#/$defs/C4ComparisonLanguageGroup"
      },
      "title": "Language Groups",
      "type": "array"
    },
    "limit": {
      "default": 20,
      "title": "Limit",
      "type": "integer"
    },
    "metric_summaries": {
      "default": [],
      "items": {
        "$ref": "#/$defs/C4ComparisonMetricSummary"
      },
      "title": "Metric Summaries",
      "type": "array"
    },
    "non_diagnostic_notice": {
      "default": "This page compares saved explanation-evaluation evidence. Consistency and deletion behaviour do not establish prediction correctness or clinical validity. The system supports counsellor-assisted screening review and does not replace professional counselling.",
      "title": "Non Diagnostic Notice",
      "type": "string"
    },
    "offset": {
      "default": 0,
      "title": "Offset",
      "type": "integer"
    },
    "paired_items": {
      "default": [],
      "items": {
        "$ref": "#/$defs/C4PairedEvidenceItem"
      },
      "title": "Paired Items",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "selected_metric": {
      "title": "Selected Metric",
      "type": "string"
    },
    "selection_rules": {
      "default": "Deterministic default: latest successfully completed compatible LIME and SHAP pair within selected configuration.",
      "title": "Selection Rules",
      "type": "string"
    },
    "synthetic": {
      "const": true,
      "default": true,
      "title": "Synthetic",
      "type": "boolean"
    },
    "total_items": {
      "default": 0,
      "title": "Total Items",
      "type": "integer"
    }
  },
  "required": [
    "coverage",
    "selected_metric"
  ],
  "title": "C4ComparisonEvaluatedResponse",
  "type": "object"
}
