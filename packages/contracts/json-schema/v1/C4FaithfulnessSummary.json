      "type": "boolean"
    },
    "method": {
      "enum": [
        "LIME",
        "SHAP"
      ],
      "title": "Method",
      "type": "string"
    },
    "outcome": {
      "title": "Outcome",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_reference": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Reference"
    },
    "synthetic": {
      "const": true,
      "default": true,
      "title": "Synthetic",
      "type": "boolean"
    }
  },
  "required": [
    "evaluation_id",
    "explanation_id",
    "created_at",
    "method",
    "explained_class",
    "baseline_probability",
    "outcome"
