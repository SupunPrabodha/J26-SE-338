{
  "$id": "https://j26.invalid/contracts/1.0.0/C4FaithfulnessSummary.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "aopc": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Aopc"
    },
    "baseline_probability": {
      "title": "Baseline Probability",
      "type": "number"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "development_only": {
      "const": true,
      "default": true,
      "title": "Development Only",
      "type": "boolean"
    },
    "evaluation_id": {
      "format": "uuid",
      "title": "Evaluation Id",
      "type": "string"
    },
    "explained_class": {
      "title": "Explained Class",
      "type": "string"
    },
    "explanation_id": {
      "format": "uuid",
      "title": "Explanation Id",
      "type": "string"
    },
