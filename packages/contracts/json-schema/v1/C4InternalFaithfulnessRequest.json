    },
    "method": {
      "enum": [
        "LIME",
        "SHAP"
      ],
      "title": "Method",
      "type": "string"
    },
    "model_revision": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Revision"
    },
    "random_trials": {
      "default": 5,
      "title": "Random Trials",
      "type": "integer"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "seed": {
      "default": 42,
