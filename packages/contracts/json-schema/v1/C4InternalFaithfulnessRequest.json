        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "synthetic": {
          "const": true,
          "default": true,
          "title": "Synthetic",
          "type": "boolean"
        },
        "token": {
          "title": "Token",
          "type": "string"
        },
        "weight": {
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "token",
        "weight",
        "direction",
        "abs_weight"
      ],
      "title": "FeatureContribution",
      "type": "object"
    }
  },
