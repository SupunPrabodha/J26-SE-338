        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Language"
    },
    "max_removal_pct": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
