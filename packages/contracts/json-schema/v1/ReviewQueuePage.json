{
  "$defs": {
    "ErrorCode": {
      "enum": [
        "AUTH_REQUIRED",
        "AUTH_INVALID",
        "FORBIDDEN",
        "NOT_FOUND",
        "CONSENT_REQUIRED",
        "CONSENT_INVALID",
        "CONTRACT_INVALID",
        "CONFLICT",
        "RATE_LIMITED",
        "DEPENDENCY_UNAVAILABLE",
        "DOWNSTREAM_FAILED",
        "DOWNSTREAM_TIMEOUT",
        "RETRY_EXHAUSTED",
        "INTERNAL_ERROR"
      ],
      "title": "ErrorCode",
      "type": "string"
    },
    "PseudonymousCase": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "format": "uuid",
          "title": "Case Id",
          "type": "string"
        },
        "correlation_id": {
          "format": "uuid",
          "title": "Correlation Id",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "development_only": {
          "const": true,
          "default": true,
          "title": "Development Only",
          "type": "boolean"
        },
        "error_code": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorCode"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "processing_status": {
          "$ref": "#/$defs/WorkflowState"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "synthetic": {
          "const": true,
          "default": true,
          "title": "Synthetic",
          "type": "boolean"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "correlation_id",
        "processing_status",
        "created_at",
        "updated_at"
      ],
      "title": "PseudonymousCase",
      "type": "object"
    },
    "ReviewQueueItem": {
      "additionalProperties": false,
      "properties": {
        "assignment": {
          "const": "ASSIGNED_TO_YOU",
          "default": "ASSIGNED_TO_YOU",
          "title": "Assignment",
          "type": "string"
        },
        "case": {
          "$ref": "#/$defs/PseudonymousCase"
        },
        "development_only": {
          "const": true,
          "default": true,
          "title": "Development Only",
          "type": "boolean"
        },
        "review_completed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Review Completed At"
        },
        "review_record_saved_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Review Record Saved At"
        },
        "review_started_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Review Started At"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "synthetic": {
          "const": true,
          "default": true,
          "title": "Synthetic",
          "type": "boolean"
        },
        "task_id": {
          "format": "uuid",
          "title": "Task Id",
          "type": "string"
        }
      },
      "required": [
        "task_id",
        "case"
      ],
      "title": "ReviewQueueItem",
      "type": "object"
    },
    "WorkflowState": {
      "enum": [
        "RECEIVED",
        "CONSENT_VERIFIED",
        "PREPROCESSING",
        "INFERENCE",
        "EXPLANATION",
        "READY_FOR_REVIEW",
        "UNDER_REVIEW",
        "COMPLETED",
        "FAILED",
        "WITHDRAWAL_REQUESTED",
        "WITHDRAWN"
      ],
      "title": "WorkflowState",
      "type": "string"
    }
  },
  "$id": "https://j26.invalid/contracts/1.0.0/ReviewQueuePage.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "development_only": {
      "const": true,
      "default": true,
      "title": "Development Only",
      "type": "boolean"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/ReviewQueueItem"
      },
      "maxItems": 20,
      "title": "Items",
      "type": "array"
    },
    "next_offset": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Next Offset"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "synthetic": {
      "const": true,
      "default": true,
      "title": "Synthetic",
      "type": "boolean"
    }
  },
  "required": [
    "items",
    "observed_at"
  ],
  "title": "ReviewQueuePage",
  "type": "object"
}
