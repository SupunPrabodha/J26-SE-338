{
  "$id": "https://j26.invalid/contracts/1.0.0/StaffProfile.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "account_expires_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Account Expires At"
    },
    "account_id": {
      "format": "uuid",
      "title": "Account Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "development_only": {
      "const": true,
      "default": true,
      "title": "Development Only",
      "type": "boolean"
    },
    "enabled": {
      "title": "Enabled",
      "type": "boolean"
    },
    "remember_me": {
      "title": "Remember Me",
      "type": "boolean"
    },
    "role": {
      "enum": [
        "ADMIN",
        "COUNSELLOR",
        "RESEARCHER"
      ],
      "title": "Role",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "session_expires_at": {
      "format": "date-time",
      "title": "Session Expires At",
      "type": "string"
    },
    "synthetic": {
      "const": true,
      "default": true,
      "title": "Synthetic",
      "type": "boolean"
    }
  },
  "required": [
    "account_id",
    "role",
    "enabled",
    "created_at",
    "session_expires_at",
    "remember_me"
  ],
  "title": "StaffProfile",
  "type": "object"
}
