{
  "$defs": {
    "ConsentState": {
      "enum": [
        "PENDING",
        "ACTIVE",
        "EXPIRED",
        "WITHDRAWN",
        "REJECTED",
        "INVALID"
      ],
      "title": "ConsentState",
      "type": "string"
    },
    "WorkflowState": {
      "enum": [
        "RECEIVED",
        "CONSENT_VERIFIED",
        "PREPROCESSING",
        "INFERENCE",
        "EXPLANATION",
        "READY_FOR_REVIEW",
        "UNDER_REVIEW",
        "COMPLETED",
        "FAILED",
        "WITHDRAWAL_REQUESTED",
        "WITHDRAWN"
      ],
      "title": "WorkflowState",
      "type": "string"
    }
  },
  "$id": "https://j26.invalid/contracts/1.0.0/DemoRun.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "case_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Case Id"
    },
    "consent_status": {
      "$ref": "#/$defs/ConsentState"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "development_only": {
      "const": true,
      "default": true,
      "title": "Development Only",
      "type": "boolean"
    },
    "processing_status": {
      "anyOf": [
        {
          "$ref": "#/$defs/WorkflowState"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "synthetic": {
      "const": true,
      "default": true,
      "title": "Synthetic",
      "type": "boolean"
    }
  },
  "required": [
    "run_id",
    "created_at",
    "consent_status"
  ],
  "title": "DemoRun",
  "type": "object"
}
