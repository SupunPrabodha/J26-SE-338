{
  "$defs": {
    "ConsentState": {
      "enum": [
        "PENDING",
        "ACTIVE",
        "EXPIRED",
        "WITHDRAWN",
        "REJECTED",
        "INVALID"
      ],
      "title": "ConsentState",
      "type": "string"
    }
  },
  "$id": "https://j26.invalid/contracts/1.0.0/ConsentRecord.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "consent_id": {
      "format": "uuid",
      "title": "Consent Id",
      "type": "string"
    },
    "consent_status": {
      "$ref": "#/$defs/ConsentState"
    },
    "consent_version": {
      "title": "Consent Version",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "development_only": {
      "const": true,
      "default": true,
      "title": "Development Only",
      "type": "boolean"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "purpose": {
      "title": "Purpose",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "synthetic": {
      "const": true,
      "default": true,
      "title": "Synthetic",
      "type": "boolean"
    }
  },
  "required": [
    "consent_id",
    "consent_status",
    "consent_version",
    "purpose",
    "created_at",
    "expires_at"
  ],
  "title": "ConsentRecord",
  "type": "object"
}
