{
  "$id": "https://j26.invalid/contracts/1.0.0/C4CounterfactualRequest.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "development_only": {
      "const": true,
      "default": true,
      "title": "Development Only",
      "type": "boolean"
    },
    "idempotency_key": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Idempotency Key"
    },
    "language": {
      "anyOf": [
        {
          "enum": [
            "English",
            "Sinhala",
            "Romanized Sinhala",
            "Code-mixed"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Language"
    },
    "max_candidates": {
      "default": 50,
      "title": "Max Candidates",
      "type": "integer"
    },
    "max_edits": {
      "default": 2,
      "title": "Max Edits",
      "type": "integer"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_reference": {
      "anyOf": [
        {
          "maxLength": 100,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Reference"
    },
    "synthetic": {
      "const": true,
      "default": true,
      "title": "Synthetic",
      "type": "boolean"
    },
    "target_class": {
      "enum": [
        "Negative",
        "Neutral",
        "Positive"
      ],
      "title": "Target Class",
      "type": "string"
    },
    "text": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Text",
      "type": "string"
    }
  },
  "required": [
    "text",
    "target_class"
  ],
  "title": "C4CounterfactualRequest",
  "type": "object"
}
