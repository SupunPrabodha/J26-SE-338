{
  "$id": "https://j26.invalid/contracts/1.0.0/C4ComparisonCandidateRecord.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "development_only": {
      "const": true,
      "default": true,
      "title": "Development Only",
      "type": "boolean"
    },
    "explanation_id": {
      "format": "uuid",
      "title": "Explanation Id",
      "type": "string"
    },
    "incompatibility_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Incompatibility Reason"
    },
    "is_compatible": {
      "default": true,
      "title": "Is Compatible",
      "type": "boolean"
    },
    "method": {
      "enum": [
        "LIME",
        "SHAP"
      ],
      "title": "Method",
      "type": "string"
    },
    "record_id": {
      "format": "uuid",
      "title": "Record Id",
      "type": "string"
    },
    "record_type": {
      "enum": [
        "FAITHFULNESS",
        "STABILITY",
        "EXPLANATION"
      ],
      "title": "Record Type",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "settings": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "integer"
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          },
          {
            "type": "null"
          }
        ]
      },
      "default": {},
      "title": "Settings",
      "type": "object"
    },
    "synthetic": {
      "const": true,
      "default": true,
      "title": "Synthetic",
      "type": "boolean"
    }
  },
  "required": [
    "record_id",
    "explanation_id",
    "method",
    "record_type",
    "created_at"
  ],
  "title": "C4ComparisonCandidateRecord",
  "type": "object"
}
