{
  "$defs": {
    "C2DemoLanguageIdentification": {
      "additionalProperties": false,
      "description": "Provisional deterministic evidence, not anonymizer configuration.",
      "properties": {
        "development_only": {
          "const": true,
          "default": true,
          "title": "Development Only",
          "type": "boolean"
        },
        "language": {
          "enum": [
            "sinhala",
            "english",
            "romanized-si",
            "code-mixed",
            "uncertain",
            "unknown"
          ],
          "title": "Language",
          "type": "string"
        },
        "method": {
          "default": "c2-rule-language-v1.1",
          "enum": [
            "c2-rule-language-v1",
            "c2-rule-language-v1.1",
            "c2-rule-language-v1.2"
          ],
          "title": "Method",
          "type": "string"
        },
        "reason": {
          "enum": [
            "no_language_letters_after_masking",
            "sinhala_script_evidence_only",
            "unsupported_script_evidence",
            "sinhala_script_and_english_markers",
            "mixed_script_without_supported_lexical_evidence",
            "english_and_romanized_markers",
            "multiple_romanized_markers",
            "multiple_english_markers",
            "insufficient_or_ambiguous_latin_evidence",
            "explicit_romanized_name_introduction",
            "sinhala_language_with_romanized_mixed_script_evidence"
          ],
          "title": "Reason",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "enum": [
            "provisional",
            "uncertain",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        },
        "synthetic": {
          "const": true,
          "default": true,
          "title": "Synthetic",
          "type": "boolean"
        },
        "uncertain": {
          "title": "Uncertain",
          "type": "boolean"
        }
      },
      "required": [
        "language",
        "status",
        "reason",
        "uncertain"
      ],
      "title": "C2DemoLanguageIdentification",
      "type": "object"
    },
    "C2DemoPrivacySummary": {
      "additionalProperties": false,
      "properties": {
        "development_only": {
          "const": true,
          "default": true,
          "title": "Development Only",
          "type": "boolean"
        },
        "issue_counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Issue Counts",
          "type": "object"
        },
        "issues": {
          "items": {
            "type": "string"
          },
          "title": "Issues",
          "type": "array"
        },
        "limitation": {
          "title": "Limitation",
          "type": "string"
        },
        "pipeline_stage": {
          "const": "release_privacy_gate",
          "title": "Pipeline Stage",
          "type": "string"
        },
        "privacy_note": {
          "title": "Privacy Note",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "enum": [
            "PASSED",
            "FAILED"
          ],
          "title": "Status",
          "type": "string"
        },
        "synthetic": {
          "const": true,
          "default": true,
          "title": "Synthetic",
          "type": "boolean"
        },
        "total_records": {
          "minimum": 0,
          "title": "Total Records",
          "type": "integer"
        }
      },
      "required": [
        "pipeline_stage",
        "total_records",
        "status",
        "issues",
        "issue_counts",
        "privacy_note",
        "limitation"
      ],
      "title": "C2DemoPrivacySummary",
      "type": "object"
    },
    "C2DemoQualityPolicy": {
      "additionalProperties": false,
      "properties": {
        "comparison_case_insensitive": {
          "title": "Comparison Case Insensitive",
          "type": "boolean"
        },
        "development_only": {
          "const": true,
          "default": true,
          "title": "Development Only",
          "type": "boolean"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "short_text_review_below": {
          "minimum": 1,
          "title": "Short Text Review Below",
          "type": "integer"
        },
        "synthetic": {
          "const": true,
          "default": true,
          "title": "Synthetic",
          "type": "boolean"
        }
      },
      "required": [
        "short_text_review_below",
        "comparison_case_insensitive"
      ],
      "title": "C2DemoQualityPolicy",
      "type": "object"
    },
    "C2DemoQualitySummary": {
      "additionalProperties": false,
      "properties": {
        "blocking_reasons": {
          "items": {
            "type": "string"
          },
          "title": "Blocking Reasons",
          "type": "array"
        },
        "data_quality_gate": {
          "enum": [
            "PASSED",
            "FAILED"
          ],
          "title": "Data Quality Gate",
          "type": "string"
        },
        "development_only": {
          "const": true,
          "default": true,
          "title": "Development Only",
          "type": "boolean"
        },
        "duplicate_text_meaning": {
          "title": "Duplicate Text Meaning",
          "type": "string"
        },
        "issue_counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Issue Counts",
          "type": "object"
        },
        "policy": {
          "$ref": "#/$defs/C2DemoQualityPolicy"
        },
        "policy_status": {
          "const": "development_only_not_research_approved",
          "title": "Policy Status",
          "type": "string"
        },
        "privacy_note": {
          "title": "Privacy Note",
          "type": "string"
        },
        "release_ready_meaning": {
          "title": "Release Ready Meaning",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "status_counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "propertyNames": {
            "enum": [
              "PASS",
              "REVIEW",
              "REJECT"
            ]
          },
          "title": "Status Counts",
          "type": "object"
        },
        "synthetic": {
          "const": true,
          "default": true,
          "title": "Synthetic",
          "type": "boolean"
        },
        "total_records": {
          "minimum": 0,
          "title": "Total Records",
          "type": "integer"
        }
      },
      "required": [
        "total_records",
        "status_counts",
        "issue_counts",
        "data_quality_gate",
        "blocking_reasons",
        "policy",
        "policy_status",
        "release_ready_meaning",
        "duplicate_text_meaning",
        "privacy_note"
      ],
      "title": "C2DemoQualitySummary",
      "type": "object"
    },
    "C2DemoRecord": {
      "additionalProperties": false,
      "properties": {
        "anonymized_text": {
          "title": "Anonymized Text",
          "type": "string"
        },
        "development_only": {
          "const": true,
          "default": true,
          "title": "Development Only",
          "type": "boolean"
        },
        "language_identification": {
          "anyOf": [
            {
              "$ref": "#/$defs/C2DemoLanguageIdentification"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "normalization_method": {
          "anyOf": [
            {
              "const": "c2-nfc-whitespace-v1",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Normalization Method"
        },
        "normalized_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Normalized Text"
        },
        "original_text": {
          "title": "Original Text",
          "type": "string"
        },
        "quality_issues": {
          "items": {
            "type": "string"
          },
          "title": "Quality Issues",
          "type": "array"
        },
        "quality_status": {
          "enum": [
            "PASS",
            "REVIEW",
            "REJECT"
          ],
          "title": "Quality Status",
          "type": "string"
        },
        "record_id": {
          "title": "Record Id",
          "type": "string"
        },
        "requires_privacy_review": {
          "title": "Requires Privacy Review",
          "type": "boolean"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "synthetic": {
          "const": true,
          "default": true,
          "title": "Synthetic",
          "type": "boolean"
        },
        "token_offset_unit": {
          "anyOf": [
            {
              "const": "unicode_code_points",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Token Offset Unit"
        },
        "token_offsets": {
          "anyOf": [
            {
              "items": {
                "items": {
                  "minimum": 0,
                  "type": "integer"
                },
                "maxItems": 2,
                "minItems": 2,
                "type": "array"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Zero-based [start, end) Unicode code points in normalized_text; not UTF-16 units.",
          "title": "Token Offsets"
        },
        "tokenization_method": {
          "anyOf": [
            {
              "const": "c2-grapheme-words-v1",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tokenization Method"
        },
        "tokens": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tokens"
        },
        "transformations": {
          "items": {
            "type": "string"
          },
          "title": "Transformations",
          "type": "array"
        }
      },
      "required": [
        "record_id",
        "original_text",
        "anonymized_text",
        "transformations",
        "quality_status",
        "quality_issues",
        "requires_privacy_review"
      ],
      "title": "C2DemoRecord",
      "type": "object"
    },
    "C2DemoRecordValidation": {
      "additionalProperties": false,
      "properties": {
        "checks": {
          "items": {
            "$ref": "#/$defs/C2DemoValidationCheck"
          },
          "title": "Checks",
          "type": "array"
        },
        "development_only": {
          "const": true,
          "default": true,
          "title": "Development Only",
          "type": "boolean"
        },
        "record_index": {
          "minimum": 1,
          "title": "Record Index",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "synthetic": {
          "const": true,
          "default": true,
          "title": "Synthetic",
          "type": "boolean"
        }
      },
      "required": [
        "record_index",
        "checks"
      ],
      "title": "C2DemoRecordValidation",
      "type": "object"
    },
    "C2DemoStageValidation": {
      "additionalProperties": false,
      "properties": {
        "checked_records": {
          "minimum": 0,
          "title": "Checked Records",
          "type": "integer"
        },
        "development_only": {
          "const": true,
          "default": true,
          "title": "Development Only",
          "type": "boolean"
        },
        "failed_records": {
          "minimum": 0,
          "title": "Failed Records",
          "type": "integer"
        },
        "not_evaluated_records": {
          "minimum": 0,
          "title": "Not Evaluated Records",
          "type": "integer"
        },
        "pass_rate_percent": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pass Rate Percent"
        },
        "passed_records": {
          "minimum": 0,
          "title": "Passed Records",
          "type": "integer"
        },
        "review_records": {
          "minimum": 0,
          "title": "Review Records",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "stage": {
          "enum": [
            "anonymization",
            "quality",
            "language_id",
            "normalization",
            "tokenization"
          ],
          "title": "Stage",
          "type": "string"
        },
        "synthetic": {
          "const": true,
          "default": true,
          "title": "Synthetic",
          "type": "boolean"
        }
      },
      "required": [
        "stage",
        "checked_records",
        "passed_records",
        "failed_records",
        "review_records",
        "not_evaluated_records"
      ],
      "title": "C2DemoStageValidation",
      "type": "object"
    },
    "C2DemoValidationCheck": {
      "additionalProperties": false,
      "properties": {
        "development_only": {
          "const": true,
          "default": true,
          "title": "Development Only",
          "type": "boolean"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "REVIEW",
            "NOT_EVALUATED"
          ],
          "title": "Status",
          "type": "string"
        },
        "synthetic": {
          "const": true,
          "default": true,
          "title": "Synthetic",
          "type": "boolean"
        }
      },
      "required": [
        "rule_id",
        "status",
        "reasons"
      ],
      "title": "C2DemoValidationCheck",
      "type": "object"
    },
    "C2DemoValidationRule": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "title": "Description",
          "type": "string"
        },
        "development_only": {
          "const": true,
          "default": true,
          "title": "Development Only",
          "type": "boolean"
        },
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_function": {
          "enum": [
            "check_privacy",
            "check_quality",
            "check_language",
            "check_normalization",
            "check_tokens",
            "check_residual_output"
          ],
          "title": "Source Function",
          "type": "string"
        },
        "source_path": {
          "const": "services/preprocessing/validation.py",
          "title": "Source Path",
          "type": "string"
        },
        "synthetic": {
          "const": true,
          "default": true,
          "title": "Synthetic",
          "type": "boolean"
        }
      },
      "required": [
        "rule_id",
        "description",
        "source_path",
        "source_function"
      ],
      "title": "C2DemoValidationRule",
      "type": "object"
    },
    "C2DemoValidationSummary": {
      "additionalProperties": false,
      "properties": {
        "accuracy_status": {
          "const": "NOT_MEASURED",
          "title": "Accuracy Status",
          "type": "string"
        },
        "anonymization_strategy": {
          "enum": [
            "regex",
            "presidio",
            "hybrid",
            "gliner"
          ],
          "title": "Anonymization Strategy",
          "type": "string"
        },
        "development_only": {
          "const": true,
          "default": true,
          "title": "Development Only",
          "type": "boolean"
        },
        "measurement": {
          "const": "policy_and_integrity_checks_not_accuracy",
          "title": "Measurement",
          "type": "string"
        },
        "method": {
          "enum": [
            "c2-output-validation-v1",
            "c2-output-validation-v1.1+residual-output-v1"
          ],
          "title": "Method",
          "type": "string"
        },
        "records": {
          "items": {
            "$ref": "#/$defs/C2DemoRecordValidation"
          },
          "title": "Records",
          "type": "array"
        },
        "records_processed": {
          "minimum": 0,
          "title": "Records Processed",
          "type": "integer"
        },
        "release_policy_unchanged": {
          "title": "Release Policy Unchanged",
          "type": "boolean"
        },
        "rules": {
          "items": {
            "$ref": "#/$defs/C2DemoValidationRule"
          },
          "title": "Rules",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "stages": {
          "items": {
            "$ref": "#/$defs/C2DemoStageValidation"
          },
          "title": "Stages",
          "type": "array"
        },
        "synthetic": {
          "const": true,
          "default": true,
          "title": "Synthetic",
          "type": "boolean"
        }
      },
      "required": [
        "method",
        "anonymization_strategy",
        "records_processed",
        "measurement",
        "accuracy_status",
        "release_policy_unchanged",
        "rules",
        "records",
        "stages"
      ],
      "title": "C2DemoValidationSummary",
      "type": "object"
    }
  },
  "$id": "https://j26.invalid/contracts/1.0.0/C2CustomDemoResponse.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "anonymization_configuration": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Anonymization Configuration"
    },
    "blocking_reasons": {
      "items": {
        "type": "string"
      },
      "title": "Blocking Reasons",
      "type": "array"
    },
    "development_only": {
      "const": true,
      "default": true,
      "title": "Development Only",
      "type": "boolean"
    },
    "human_release_required": {
      "const": true,
      "default": true,
      "title": "Human Release Required",
      "type": "boolean"
    },
    "independent_research_validation": {
      "const": false,
      "default": false,
      "title": "Independent Research Validation",
      "type": "boolean"
    },
    "language_hint": {
      "enum": [
        "sinhala",
        "english",
        "romanized-si",
        "code-mixed",
        "unsure"
      ],
      "title": "Language Hint",
      "type": "string"
    },
    "privacy_summary": {
      "$ref": "#/$defs/C2DemoPrivacySummary"
    },
    "quality_summary": {
      "$ref": "#/$defs/C2DemoQualitySummary"
    },
    "records": {
      "items": {
        "$ref": "#/$defs/C2DemoRecord"
      },
      "title": "Records",
      "type": "array"
    },
    "release_ready": {
      "title": "Release Ready",
      "type": "boolean"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "strategy": {
      "default": "gliner",
      "enum": [
        "presidio",
        "gliner"
      ],
      "title": "Strategy",
      "type": "string"
    },
    "synthetic": {
      "const": true,
      "default": true,
      "title": "Synthetic",
      "type": "boolean"
    },
    "validation_summary": {
      "anyOf": [
        {
          "$ref": "#/$defs/C2DemoValidationSummary"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "language_hint",
    "records",
    "quality_summary",
    "privacy_summary",
    "release_ready",
    "blocking_reasons"
  ],
  "title": "C2CustomDemoResponse",
  "type": "object"
}
