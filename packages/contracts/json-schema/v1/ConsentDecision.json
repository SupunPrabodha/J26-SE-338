{
  "$id": "https://j26.invalid/contracts/1.0.0/ConsentDecision.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "consent_status": {
      "enum": [
        "ACTIVE",
        "REJECTED"
      ],
      "title": "Consent Status",
      "type": "string"
    },
    "consent_version": {
      "const": "dev-notice-1",
      "default": "dev-notice-1",
      "title": "Consent Version",
      "type": "string"
    },
    "development_only": {
      "const": true,
      "default": true,
      "title": "Development Only",
      "type": "boolean"
    },
    "purpose": {
      "const": "synthetic-wellbeing-screening",
      "default": "synthetic-wellbeing-screening",
      "title": "Purpose",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "synthetic": {
      "const": true,
      "default": true,
      "title": "Synthetic",
      "type": "boolean"
    }
  },
  "required": [
    "consent_status"
  ],
  "title": "ConsentDecision",
  "type": "object"
}
