{
  "$defs": {
    "ErrorCode": {
      "enum": [
        "AUTH_REQUIRED",
        "AUTH_INVALID",
        "FORBIDDEN",
        "NOT_FOUND",
        "CONSENT_REQUIRED",
        "CONSENT_INVALID",
        "CONTRACT_INVALID",
        "CONFLICT",
        "RATE_LIMITED",
        "DEPENDENCY_UNAVAILABLE",
        "DOWNSTREAM_FAILED",
        "DOWNSTREAM_TIMEOUT",
        "RETRY_EXHAUSTED",
        "INTERNAL_ERROR"
      ],
      "title": "ErrorCode",
      "type": "string"
    },
    "ExplanationResponse": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "format": "uuid",
          "title": "Case Id",
          "type": "string"
        },
        "consent_status": {
          "const": "ACTIVE",
          "default": "ACTIVE",
          "title": "Consent Status",
          "type": "string"
        },
        "consent_version": {
          "const": "dev-notice-1",
          "default": "dev-notice-1",
          "title": "Consent Version",
          "type": "string"
        },
        "correlation_id": {
          "format": "uuid",
          "title": "Correlation Id",
          "type": "string"
        },
        "counterfactual": {
          "default": null,
          "title": "Counterfactual",
          "type": "null"
        },
        "development_only": {
          "const": true,
          "default": true,
          "title": "Development Only",
          "type": "boolean"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "explainer_version": {
          "const": "mock-1",
          "default": "mock-1",
          "title": "Explainer Version",
          "type": "string"
        },
        "faithfulness": {
          "default": null,
          "title": "Faithfulness",
          "type": "null"
        },
        "idempotency_key": {
          "format": "uuid",
          "title": "Idempotency Key",
          "type": "string"
        },
        "method": {
          "const": "MOCK_FIXED_FIXTURE",
          "default": "MOCK_FIXED_FIXTURE",
          "title": "Method",
          "type": "string"
        },
        "purpose": {
          "const": "synthetic-wellbeing-screening",
          "default": "synthetic-wellbeing-screening",
          "title": "Purpose",
          "type": "string"
        },
        "reliability_status": {
          "const": "NOT_EVALUATED",
          "default": "NOT_EVALUATED",
          "title": "Reliability Status",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "service_name": {
          "const": "xai",
          "default": "xai",
          "title": "Service Name",
          "type": "string"
        },
        "service_version": {
          "const": "0.1.0",
          "default": "0.1.0",
          "title": "Service Version",
          "type": "string"
        },
        "stability": {
          "default": null,
          "title": "Stability",
          "type": "null"
        },
        "synthetic": {
          "const": true,
          "default": true,
          "title": "Synthetic",
          "type": "boolean"
        }
      },
      "required": [
        "case_id",
        "correlation_id",
        "idempotency_key",
        "evidence"
      ],
      "title": "ExplanationResponse",
      "type": "object"
    },
    "InferenceResponse": {
      "additionalProperties": false,
      "properties": {
        "calibrated": {
          "const": false,
          "default": false,
          "title": "Calibrated",
          "type": "boolean"
        },
        "case_id": {
          "format": "uuid",
          "title": "Case Id",
          "type": "string"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "consent_status": {
          "const": "ACTIVE",
          "default": "ACTIVE",
          "title": "Consent Status",
          "type": "string"
        },
        "consent_version": {
          "const": "dev-notice-1",
          "default": "dev-notice-1",
          "title": "Consent Version",
          "type": "string"
        },
        "correlation_id": {
          "format": "uuid",
          "title": "Correlation Id",
          "type": "string"
        },
        "dataset_version": {
          "const": "synthetic-fixtures-1",
          "default": "synthetic-fixtures-1",
          "title": "Dataset Version",
          "type": "string"
        },
        "development_only": {
          "const": true,
          "default": true,
          "title": "Development Only",
          "type": "boolean"
        },
        "emotional_tone": {
          "const": "synthetic-neutral",
          "default": "synthetic-neutral",
          "title": "Emotional Tone",
          "type": "string"
        },
        "idempotency_key": {
          "format": "uuid",
          "title": "Idempotency Key",
          "type": "string"
        },
        "model_version": {
          "const": "mock-1",
          "default": "mock-1",
          "title": "Model Version",
          "type": "string"
        },
        "purpose": {
          "const": "synthetic-wellbeing-screening",
          "default": "synthetic-wellbeing-screening",
          "title": "Purpose",
          "type": "string"
        },
        "review_priority": {
          "const": "HUMAN_REVIEW_REQUIRED",
          "default": "HUMAN_REVIEW_REQUIRED",
          "title": "Review Priority",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "service_name": {
          "const": "nlp",
          "default": "nlp",
          "title": "Service Name",
          "type": "string"
        },
        "service_version": {
          "const": "0.1.0",
          "default": "0.1.0",
          "title": "Service Version",
          "type": "string"
        },
        "stress_language_signals": {
          "items": {
            "const": "synthetic-busy-timetable",
            "type": "string"
          },
          "title": "Stress Language Signals",
          "type": "array"
        },
        "synthetic": {
          "const": true,
          "default": true,
          "title": "Synthetic",
          "type": "boolean"
        },
        "wellbeing_indicator": {
          "const": "synthetic-academic-pressure",
          "default": "synthetic-academic-pressure",
          "title": "Wellbeing Indicator",
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "correlation_id",
        "idempotency_key",
        "stress_language_signals",
        "confidence"
      ],
      "title": "InferenceResponse",
      "type": "object"
    },
    "PseudonymousCase": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "format": "uuid",
          "title": "Case Id",
          "type": "string"
        },
        "correlation_id": {
          "format": "uuid",
          "title": "Correlation Id",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "development_only": {
          "const": true,
          "default": true,
          "title": "Development Only",
          "type": "boolean"
        },
        "error_code": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorCode"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "processing_status": {
          "$ref": "#/$defs/WorkflowState"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "synthetic": {
          "const": true,
          "default": true,
          "title": "Synthetic",
          "type": "boolean"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "correlation_id",
        "processing_status",
        "created_at",
        "updated_at"
      ],
      "title": "PseudonymousCase",
      "type": "object"
    },
    "WorkflowState": {
      "enum": [
        "RECEIVED",
        "CONSENT_VERIFIED",
        "PREPROCESSING",
        "INFERENCE",
        "EXPLANATION",
        "READY_FOR_REVIEW",
        "UNDER_REVIEW",
        "COMPLETED",
        "FAILED",
        "WITHDRAWAL_REQUESTED",
        "WITHDRAWN"
      ],
      "title": "WorkflowState",
      "type": "string"
    }
  },
  "$id": "https://j26.invalid/contracts/1.0.0/ReviewTask.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "case": {
      "$ref": "#/$defs/PseudonymousCase"
    },
    "development_only": {
      "const": true,
      "default": true,
      "title": "Development Only",
      "type": "boolean"
    },
    "explanation": {
      "$ref": "#/$defs/ExplanationResponse"
    },
    "human_review_required": {
      "const": true,
      "default": true,
      "title": "Human Review Required",
      "type": "boolean"
    },
    "inference": {
      "$ref": "#/$defs/InferenceResponse"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "synthetic": {
      "const": true,
      "default": true,
      "title": "Synthetic",
      "type": "boolean"
    },
    "task_id": {
      "format": "uuid",
      "title": "Task Id",
      "type": "string"
    }
  },
  "required": [
    "task_id",
    "case",
    "inference",
    "explanation"
  ],
  "title": "ReviewTask",
  "type": "object"
}
