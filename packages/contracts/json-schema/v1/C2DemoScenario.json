{
  "$id": "https://j26.invalid/contracts/1.0.0/C2DemoScenario.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "development_only": {
      "const": true,
      "default": true,
      "title": "Development Only",
      "type": "boolean"
    },
    "label": {
      "title": "Label",
      "type": "string"
    },
    "language_label": {
      "enum": [
        "english",
        "sinhala",
        "romanized-si",
        "code-mixed",
        "not-applicable"
      ],
      "title": "Language Label",
      "type": "string"
    },
    "record_count": {
      "minimum": 0,
      "title": "Record Count",
      "type": "integer"
    },
    "scenario_id": {
      "enum": [
        "english-person",
        "sinhala-person",
        "romanized-person",
        "code-mixed-person",
        "english-ordinary",
        "english",
        "sinhala",
        "romanized",
        "code-mixed",
        "short",
        "empty",
        "placeholder-only",
        "duplicate",
        "masking-collision",
        "empty-batch"
      ],
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "synthetic": {
      "const": true,
      "default": true,
      "title": "Synthetic",
      "type": "boolean"
    }
  },
  "required": [
    "scenario_id",
    "label",
    "language_label",
    "record_count"
  ],
  "title": "C2DemoScenario",
  "type": "object"
}
