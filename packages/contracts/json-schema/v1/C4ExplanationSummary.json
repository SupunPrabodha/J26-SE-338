{
  "$id": "https://j26.invalid/contracts/1.0.0/C4ExplanationSummary.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "development_only": {
      "const": true,
      "default": true,
      "title": "Development Only",
      "type": "boolean"
    },
    "explanation_id": {
      "format": "uuid",
      "title": "Explanation Id",
      "type": "string"
    },
    "is_development": {
      "default": true,
      "title": "Is Development",
      "type": "boolean"
    },
    "method": {
      "enum": [
        "LIME",
        "SHAP"
      ],
      "title": "Method",
      "type": "string"
    },
    "predicted_class": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Predicted Class"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_reference": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Reference"
    },
    "synthetic": {
      "const": true,
      "default": true,
      "title": "Synthetic",
      "type": "boolean"
    },
    "target_class": {
      "title": "Target Class",
      "type": "string"
    },
    "target_class_probability": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Class Probability"
    }
  },
  "required": [
    "explanation_id",
    "created_at",
    "method",
    "target_class"
  ],
  "title": "C4ExplanationSummary",
  "type": "object"
}
