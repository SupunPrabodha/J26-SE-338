      "enum": [
        "AUTH_LOGIN",
        "AUTH_FAILURE",
        "AUTH_LOGOUT",
        "AUTH_REFRESH",
        "SESSION_REVOKED",
        "CONSENT_RECORDED",
        "CONSENT_EXPIRED",
        "OPERATION_BLOCKED",
        "SUBMISSION",
        "SUBMISSION_REPLAY",
        "WORKFLOW_TRANSITION",
        "JOB_RETRY",
        "JOB_TERMINAL",
        "JOB_CLAIM",
        "HUMAN_REVIEW",
        "WITHDRAWAL",
        "RETENTION",
        "ASSIGNMENT",
        "ADMIN_EVIDENCE_ACCESS",
        "STAFF_ADMINISTRATION"
