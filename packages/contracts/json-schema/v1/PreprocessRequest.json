{
  "$id": "https://j26.invalid/contracts/1.0.0/PreprocessRequest.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "case_id": {
      "format": "uuid",
      "title": "Case Id",
      "type": "string"
    },
    "consent_status": {
      "const": "ACTIVE",
      "default": "ACTIVE",
      "title": "Consent Status",
      "type": "string"
    },
    "consent_version": {
      "const": "dev-notice-1",
      "default": "dev-notice-1",
      "title": "Consent Version",
      "type": "string"
    },
    "correlation_id": {
      "format": "uuid",
      "title": "Correlation Id",
      "type": "string"
    },
    "development_only": {
      "const": true,
      "default": true,
      "title": "Development Only",
      "type": "boolean"
    },
    "idempotency_key": {
      "format": "uuid",
      "title": "Idempotency Key",
      "type": "string"
    },
    "purpose": {
      "const": "synthetic-wellbeing-screening",
      "default": "synthetic-wellbeing-screening",
      "title": "Purpose",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "synthetic": {
      "const": true,
      "default": true,
      "title": "Synthetic",
      "type": "boolean"
    },
    "text": {
      "maxLength": 1000,
      "minLength": 1,
      "title": "Text",
      "type": "string"
    }
  },
  "required": [
    "case_id",
    "correlation_id",
    "idempotency_key",
    "text"
  ],
  "title": "PreprocessRequest",
  "type": "object"
}
