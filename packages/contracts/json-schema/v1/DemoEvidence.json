{
  "$defs": {
    "ConsentState": {
      "enum": [
        "PENDING",
        "ACTIVE",
        "EXPIRED",
        "WITHDRAWN",
        "REJECTED",
        "INVALID"
      ],
      "title": "ConsentState",
      "type": "string"
    },
    "DemoReceipt": {
      "additionalProperties": false,
      "properties": {
        "development_only": {
          "const": true,
          "default": true,
          "title": "Development Only",
          "type": "boolean"
        },
        "event": {
          "enum": [
            "CONSENT_RECORDED",
            "CONSENT_EXPIRED",
            "OPERATION_BLOCKED",
            "SUBMISSION_REPLAY",
            "WORKFLOW_TRANSITION",
            "JOB_RETRY",
            "JOB_TERMINAL",
            "HUMAN_REVIEW",
            "WITHDRAWAL",
            "RETENTION"
          ],
          "title": "Event",
          "type": "string"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "synthetic": {
          "const": true,
          "default": true,
          "title": "Synthetic",
          "type": "boolean"
        }
      },
      "required": [
        "event",
        "occurred_at"
      ],
      "title": "DemoReceipt",
      "type": "object"
    },
    "DemoRun": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Case Id"
        },
        "consent_status": {
          "$ref": "#/$defs/ConsentState"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "development_only": {
          "const": true,
          "default": true,
          "title": "Development Only",
          "type": "boolean"
        },
        "processing_status": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorkflowState"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "run_id": {
          "format": "uuid",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "synthetic": {
          "const": true,
          "default": true,
          "title": "Synthetic",
          "type": "boolean"
        }
      },
      "required": [
        "run_id",
        "created_at",
        "consent_status"
      ],
      "title": "DemoRun",
      "type": "object"
    },
    "WorkflowState": {
      "enum": [
        "RECEIVED",
        "CONSENT_VERIFIED",
        "PREPROCESSING",
        "INFERENCE",
        "EXPLANATION",
        "READY_FOR_REVIEW",
        "UNDER_REVIEW",
        "COMPLETED",
        "FAILED",
        "WITHDRAWAL_REQUESTED",
        "WITHDRAWN"
      ],
      "title": "WorkflowState",
      "type": "string"
    }
  },
  "$id": "https://j26.invalid/contracts/1.0.0/DemoEvidence.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "blocking_observed": {
      "title": "Blocking Observed",
      "type": "boolean"
    },
    "consent_policy_valid": {
      "title": "Consent Policy Valid",
      "type": "boolean"
    },
    "consent_recorded": {
      "title": "Consent Recorded",
      "type": "boolean"
    },
    "development_only": {
      "const": true,
      "default": true,
      "title": "Development Only",
      "type": "boolean"
    },
    "disposal_confirmed": {
      "title": "Disposal Confirmed",
      "type": "boolean"
    },
    "failure_observed": {
      "title": "Failure Observed",
      "type": "boolean"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "provenance_validated": {
      "title": "Provenance Validated",
      "type": "boolean"
    },
    "provider": {
      "const": "MOCK_SYNTHETIC_DEVELOPMENT_ONLY",
      "default": "MOCK_SYNTHETIC_DEVELOPMENT_ONLY",
      "title": "Provider",
      "type": "string"
    },
    "receipt_only": {
      "title": "Receipt Only",
      "type": "boolean"
    },
    "receipts": {
      "items": {
        "$ref": "#/$defs/DemoReceipt"
      },
      "maxItems": 50,
      "title": "Receipts",
      "type": "array"
    },
    "receipts_truncated": {
      "title": "Receipts Truncated",
      "type": "boolean"
    },
    "replay_observed": {
      "title": "Replay Observed",
      "type": "boolean"
    },
    "review_completed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Review Completed At"
    },
    "review_record_saved_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Review Record Saved At"
    },
    "review_started_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Review Started At"
    },
    "review_task_authorized": {
      "title": "Review Task Authorized",
      "type": "boolean"
    },
    "run": {
      "$ref": "#/$defs/DemoRun"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "synthetic": {
      "const": true,
      "default": true,
      "title": "Synthetic",
      "type": "boolean"
    },
    "withdrawn_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Withdrawn At"
    }
  },
  "required": [
    "run",
    "observed_at",
    "receipt_only",
    "consent_recorded",
    "consent_policy_valid",
    "blocking_observed",
    "replay_observed",
    "failure_observed",
    "provenance_validated",
    "review_task_authorized",
    "disposal_confirmed",
    "receipts",
    "receipts_truncated"
  ],
  "title": "DemoEvidence",
  "type": "object"
}
