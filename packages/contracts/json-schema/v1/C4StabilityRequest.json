{
  "$id": "https://j26.invalid/contracts/1.0.0/C4StabilityRequest.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "base_seed": {
      "default": 42,
      "maximum": 2147483647,
      "minimum": 0,
      "title": "Base Seed",
      "type": "integer"
    },
    "development_only": {
      "const": true,
      "default": true,
      "title": "Development Only",
      "type": "boolean"
    },
    "explainer_evals": {
      "anyOf": [
        {
          "maximum": 500,
          "minimum": 10,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Explainer Evals"
    },
    "explanation_id": {
      "format": "uuid",
      "title": "Explanation Id",
      "type": "string"
    },
    "idempotency_key": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Idempotency Key"
    },
    "language": {
      "anyOf": [
        {
          "enum": [
            "English",
            "Sinhala",
            "Romanized Sinhala",
            "Code-mixed"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Language"
    },
    "run_count": {
      "default": 5,
      "maximum": 20,
      "minimum": 2,
      "title": "Run Count",
      "type": "integer"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_reference": {
      "anyOf": [
        {
          "maxLength": 100,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Reference"
    },
    "synthetic": {
      "const": true,
      "default": true,
      "title": "Synthetic",
      "type": "boolean"
    },
    "text": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Text",
      "type": "string"
    },
    "top_k": {
      "default": 5,
      "maximum": 50,
      "minimum": 1,
      "title": "Top K",
      "type": "integer"
    }
  },
  "required": [
    "explanation_id",
    "text"
  ],
  "title": "C4StabilityRequest",
  "type": "object"
}
