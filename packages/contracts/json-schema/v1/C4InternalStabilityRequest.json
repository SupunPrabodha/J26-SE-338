{
  "$id": "https://j26.invalid/contracts/1.0.0/C4InternalStabilityRequest.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "base_seed": {
      "default": 42,
      "title": "Base Seed",
      "type": "integer"
    },
    "development_only": {
      "const": true,
      "default": true,
      "title": "Development Only",
      "type": "boolean"
    },
    "explained_class": {
      "title": "Explained Class",
      "type": "string"
    },
    "explainer_evals": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Explainer Evals"
    },
    "explanation_id": {
      "format": "uuid",
      "title": "Explanation Id",
      "type": "string"
    },
    "language": {
      "anyOf": [
        {
          "enum": [
            "English",
            "Sinhala",
            "Romanized Sinhala",
            "Code-mixed"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Language"
    },
    "method": {
      "enum": [
        "LIME",
        "SHAP"
      ],
      "title": "Method",
      "type": "string"
    },
    "model_revision": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Revision"
    },
    "run_count": {
      "default": 5,
      "title": "Run Count",
      "type": "integer"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "synthetic": {
      "const": true,
      "default": true,
      "title": "Synthetic",
      "type": "boolean"
    },
    "target_class_probability": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Class Probability"
    },
    "text": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Text",
      "type": "string"
    },
    "top_k": {
      "default": 5,
      "title": "Top K",
      "type": "integer"
    }
  },
  "required": [
    "text",
    "explanation_id",
    "method",
    "explained_class"
  ],
  "title": "C4InternalStabilityRequest",
  "type": "object"
}
