{
  "$defs": {
    "CounterfactualCandidate": {
      "additionalProperties": false,
      "properties": {
        "candidate_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candidate Text"
        },
        "development_only": {
          "const": true,
          "default": true,
          "title": "Development Only",
          "type": "boolean"
        },
        "diff_spans": {
          "default": [],
          "items": {
            "$ref": "#/$defs/TextSpanDiff"
          },
          "title": "Diff Spans",
          "type": "array"
        },
        "edit_count": {
          "title": "Edit Count",
          "type": "integer"
        },
        "edits": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EditOperation"
          },
          "title": "Edits",
          "type": "array"
        },
        "minimality_description": {
          "default": "Smallest edit distance found within this bounded search; not a global guarantee.",
          "title": "Minimality Description",
          "type": "string"
        },
        "minimality_rank": {
          "default": 1,
          "title": "Minimality Rank",
          "type": "integer"
        },
        "predicted_class": {
          "title": "Predicted Class",
          "type": "string"
        },
        "probabilities": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Probabilities",
          "type": "object"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "synthetic": {
          "const": true,
          "default": true,
          "title": "Synthetic",
          "type": "boolean"
        },
        "target_probability": {
          "title": "Target Probability",
          "type": "number"
        },
        "target_probability_delta": {
          "title": "Target Probability Delta",
          "type": "number"
        },
        "verified": {
          "default": true,
          "title": "Verified",
          "type": "boolean"
        }
      },
      "required": [
        "edit_count",
        "predicted_class",
        "probabilities",
        "target_probability",
        "target_probability_delta"
      ],
      "title": "CounterfactualCandidate",
      "type": "object"
    },
    "EditOperation": {
      "additionalProperties": false,
      "properties": {
        "development_only": {
          "const": true,
          "default": true,
          "title": "Development Only",
          "type": "boolean"
        },
        "index": {
          "title": "Index",
          "type": "integer"
        },
        "op": {
          "enum": [
            "delete",
            "replace",
            "insert"
          ],
          "title": "Op",
          "type": "string"
        },
        "original": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Original"
        },
        "replacement": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Replacement"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "synthetic": {
          "const": true,
          "default": true,
          "title": "Synthetic",
          "type": "boolean"
        }
      },
      "required": [
        "op",
        "index"
      ],
      "title": "EditOperation",
      "type": "object"
    },
    "TextSpanDiff": {
      "additionalProperties": false,
      "properties": {
        "development_only": {
          "const": true,
          "default": true,
          "title": "Development Only",
          "type": "boolean"
        },
        "original_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Original Text"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "synthetic": {
          "const": true,
          "default": true,
          "title": "Synthetic",
          "type": "boolean"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "type": {
          "enum": [
            "unchanged",
            "deleted",
            "inserted",
            "replaced"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "text",
        "type"
      ],
      "title": "TextSpanDiff",
      "type": "object"
    }
  },
  "$id": "https://j26.invalid/contracts/1.0.0/C4CounterfactualResponse.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "best_candidate": {
      "anyOf": [
        {
          "$ref": "#/$defs/CounterfactualCandidate"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "candidates": {
      "default": [],
      "items": {
        "$ref": "#/$defs/CounterfactualCandidate"
      },
      "title": "Candidates",
      "type": "array"
    },
    "counterfactual_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Counterfactual Id"
    },
    "created_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Created At"
    },
    "development_only": {
      "const": true,
      "default": true,
      "title": "Development Only",
      "type": "boolean"
    },
    "execution_time_ms": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Execution Time Ms"
    },
    "is_development": {
      "default": true,
      "title": "Is Development",
      "type": "boolean"
    },
    "model_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Id"
    },
    "model_revision": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Revision"
    },
    "model_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Version"
    },
    "non_diagnostic_notice": {
      "default": "Model-behaviour exploration only. Non-diagnostic output for screening support; requires authorized human interpretation and does not constitute wellbeing or treatment advice.",
      "title": "Non Diagnostic Notice",
      "type": "string"
    },
    "original_predicted_class": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Original Predicted Class"
    },
    "original_probabilities": {
      "additionalProperties": {
        "type": "number"
      },
      "default": {},
      "title": "Original Probabilities",
      "type": "object"
    },
    "outcome": {
      "default": "SUCCESS",
      "enum": [
        "SUCCESS",
        "NO_COUNTERFACTUAL_FOUND",
        "ALREADY_TARGET_CLASS",
        "SEARCH_LIMIT_EXCEEDED",
        "TIMEOUT",
        "UNAVAILABLE_MODEL"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "outcome_message": {
      "title": "Outcome Message",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "search_limits": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "number"
          },
          {
            "type": "string"
          }
        ]
      },
      "default": {},
      "title": "Search Limits",
      "type": "object"
    },
    "source_reference": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Reference"
    },
    "supported_languages": {
      "default": [
        "English",
        "Sinhala",
        "Romanized Sinhala",
        "Code-mixed"
      ],
      "items": {
        "type": "string"
      },
      "title": "Supported Languages",
      "type": "array"
    },
    "synthetic": {
      "const": true,
      "default": true,
      "title": "Synthetic",
      "type": "boolean"
    },
    "target_class": {
      "title": "Target Class",
      "type": "string"
    }
  },
  "required": [
    "target_class",
    "outcome_message"
  ],
  "title": "C4CounterfactualResponse",
  "type": "object"
}
